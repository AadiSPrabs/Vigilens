<svg width="1280" height="720" xmlns="http://www.w3.org/2000/svg">
  <rect width="1280" height="720" fill="#f0f4f8"/>
  <rect y="500" width="1280" height="220" fill="#8b7355"/>
  <!-- Crane Zone area marked -->
  <rect x="80" y="250" width="400" height="250" fill="none" stroke="#dc2626" stroke-width="3" stroke-dasharray="10,10" opacity="0.5"/>
  <!-- Crane -->
  <rect x="60" y="220" width="20" height="280" fill="#666"/>
  <rect x="40" y="200" width="60" height="20" fill="#666"/>
  <line x1="70" y1="200" x2="180" y2="120" stroke="#666" stroke-width="10"/>
  <!-- Person 1 - missing helmet, in hazard zone -->
  <ellipse cx="250" cy="540" rx="30" ry="35" fill="#d4a574"/>
  <rect x="225" y="575" width="50" height="80" rx="10" fill="#1e40af"/>
  <rect x="220" y="580" width="15" height="40" rx="5" fill="#1e40af"/>
  <rect x="290" y="580" width="15" height="40" rx="5" fill="#1e40af"/>
  <rect x="230" y="655" width="18" height="35" rx="5" fill="#333"/>
  <rect x="262" y="655" width="18" height="35" rx="5" fill="#333"/>
  <!-- NO hard hat - just hair/head -->
  <ellipse cx="250" cy="510" rx="22" ry="28" fill="#8b4513"/>
  <!-- Person 2 - missing vest, in hazard zone -->
  <ellipse cx="350" cy="550" rx="28" ry="33" fill="#c68642"/>
  <rect x="328" y="583" width="44" height="75" rx="10" fill="#374151"/>
  <rect x="324" y="588" width="14" height="38" rx="5" fill="#374151"/>
  <rect x="382" y="588" width="14" height="38" rx="5" fill="#374151"/>
  <rect x="332" y="658" width="16" height="32" rx="5" fill="#333"/>
  <rect x="360" y="658" width="16" height="32" rx="5" fill="#333"/>
  <ellipse cx="350" cy="520" rx="26" ry="16" fill="#fbbf24"/>
  <rect x="324" y="520" width="52" height="7" rx="3.5" fill="#fbbf24"/>
  <!-- No hi-vis vest - just dark shirt visible -->
  <text x="640" y="60" font-family="Arial, sans-serif" font-size="32" fill="#991b1b" text-anchor="middle">Vigilens Sample 2 - Missing PPE</text>
</svg>
